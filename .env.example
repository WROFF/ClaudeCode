# Copy this file to .env.local and fill in real values.
#
# 1. AUTH_SECRET — used to encrypt the session cookie / JWT.
#    Generate one with:  npx auth secret
AUTH_SECRET=

# 2. Google OAuth credentials from the Google Cloud Console:
#    https://console.cloud.google.com/apis/credentials
#    Create an "OAuth 2.0 Client ID" of type "Web application".
#    Authorized redirect URI (dev):
#      http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: set explicitly in production (e.g. https://yourdomain.com).
# In dev, Auth.js infers this automatically.
# AUTH_URL=

# Production self-hosting only (NOT needed for `npm run dev`, and auto-handled
# on Vercel). Set to true when running behind your own proxy so Auth.js trusts
# the incoming Host header.
# AUTH_TRUST_HOST=true
